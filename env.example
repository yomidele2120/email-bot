# Database (Railway will auto-fill these if you add a MySQL plugin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=email_bot
DB_USER=root
DB_PASS=

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Yomi

# App
APP_URL=https://your-app.up.railway.app
BATCH_SIZE=25

# AI Template Generator (optional — feature errors gracefully without it)
# Free, no credit card — get a key at aistudio.google.com
GEMINI_API_KEY=

# reCAPTCHA on signup (optional — signup works without it if left blank)
# Get keys at google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Paystack (billing/upgrades) — get keys at dashboard.paystack.com/#/settings/developer
# Upgrades are disabled gracefully until PAYSTACK_SECRET_KEY is set.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Paystack Plan codes for recurring subscriptions — create these once under
# Paystack Dashboard > Billing > Plans (monthly interval, NGN, matching the
# prices in src/Plan.php: Starter ₦4,500, Growth ₦12,000, Agency ₦35,000).
# Each plan gives you a code like PLN_xxxxxxxxxxxx — paste it below.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_AGENCY=

# Google AdSense — get these once your site is approved at adsense.google.com
# Ads are skipped gracefully until ADSENSE_CLIENT_ID is set. Ads never show to
# users on a paid plan, only to anonymous visitors and free-tier accounts.
# Defaults to ca-pub-6552300898888939 if left blank — override here if that ever changes.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_TOOL=

# Comma-separated list of account emails that always get unlimited (Agency-tier)
# access, no subscription required. Use this for your own account(s).
# e.g. ADMIN_EMAILS=you@yourdomain.com,cofounder@yourdomain.com
ADMIN_EMAILS=
