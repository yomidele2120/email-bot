# Database (Railway will auto-fill these if you add a MySQL plugin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=email_bot
DB_USER=root
DB_PASS=

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Yomi

# App
APP_URL=https://your-app.up.railway.app
BATCH_SIZE=25

# AI Template Generator (optional — feature errors gracefully without it)
# Free, no credit card — get a key at aistudio.google.com
GEMINI_API_KEY=

# reCAPTCHA on signup (optional — signup works without it if left blank)
# Get keys at google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
